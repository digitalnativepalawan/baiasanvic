# Supabase (Lovable Cloud) — required for site content, admin auth, storage, and bookings.
# These values are auto-injected on Lovable Cloud projects. Copy this file to
# `.env` when running locally against your own Supabase project.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-side Supabase access (service role) — used by server functions
# (site_state saves, knowledge, bookings, TALA tools). NEVER expose to the browser.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional — only used for `supabase-js` typings and Lovable tooling.
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Admin panel passkey — unlocks the admin panel AND TALA's admin surface
# (write tools over site content, knowledge, bookings, rooms, tasks).
ADMIN_PASSKEY="choose-a-strong-passkey"

# TALA agent LLM provider — configured in the admin panel (AI Concierge tab)
# and stored in the server-only concierge_config table. Nothing needed here.
